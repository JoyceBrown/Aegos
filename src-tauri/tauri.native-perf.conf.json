{
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "native-performance-measurement",
          "description": "Test-only offscreen native performance window controls",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-set-position",
            "core:window:allow-show"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Aegos WM-04 Native Measurement",
        "width": 920,
        "height": 640,
        "minWidth": 920,
        "minHeight": 640,
        "center": false,
        "x": -32000,
        "y": -32000,
        "preventOverflow": false,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true
      }
    ]
  }
}
